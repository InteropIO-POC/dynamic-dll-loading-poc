{
	"comment": "AppD component config",
	"$schema": "../../../node_modules/@finsemble/finsemble-core/configs/schemas/fileBasedSchemas/appsConfigFile.schema.json",
	"apps": [
		{
			"appId": "ChartIQ Example App",
			"name": "ChartIQ Example App",
			"type": "web",
			"details": {
				"url": "https://salesdemo-v6.finsemble.com/production/ChartIQ/Finsemble-SD-ChartIQ/technical-analysis-chart.html"
			},
			"description": "Visualize market data in the leading FDC3 compliant technical chart.",
			"hostManifests": {
				"Finsemble": {
					"window": {
						"width": 800,
						"height": 600,
						"options": {
							"minWidth": 175
						}
					}
				}
			},
			"interop": {
				"intents": {
					"listensFor": {
						"ViewChart": {
							"displayName": "View Chart",
							"contexts": ["fdc3.instrument"]
						}
					}
				}
			}
		},
		{
			"appId": "FDC3 Home",
			"name": "FDC3 Home",
			"type": "web",
			"details": {
				"url": "https://fdc3.finos.org/"
			},
			"hostManifests": {
				"Finsemble": {
					"window": {
						"width": 800,
						"height": 600,
						"options": {
							"minWidth": 175
						}
					}
				}
			}
		},
		{
			"appId": "WpfExampleApp",
			"name": "Wpf Example App",
			"type": "native",
			"details": {
				"path": "<PROJECT_ROOT>\\ExampleApps\\WpfApp\\bin\\Debug\\WpfApp.exe",
				"arguments": "containerImplPath=<PROJECT_ROOT>\\ContainerLibraries\\Container.Impl\\bin\\Debug\\Container.Impl.dll"
			},
			"hostManifests": {
				"Finsemble": {
					"component": {
						"singleton": true
					},
					"window": {
						"options": { "isEvergreen": true },
						"width": 425,
						"height": 500
					}
				}
			},
			"interop": {
				"intents": {
					"listensFor": {
						"TestNative": {
							"displayName": "Test Native",
							"contexts": ["fdc3.instrument"]
						}
					}
				}
			}
		},
		{
			"appId": "WinformExampleApp",
			"name": "Winform Example App",
			"type": "native",
			"details": {
				"path": "<PROJECT_ROOT>\\ExampleApps\\WinformApp\\bin\\Debug\\WinformApp.exe",
				"arguments": "containerImplPath=<PROJECT_ROOT>\\ContainerLibraries\\Container.Impl\\bin\\Debug\\Container.Impl.dll"
			},
			"hostManifests": {
				"Finsemble": {
					"component": {
						"singleton": true
					},
					"window": {
						"options": { "isEvergreen": true },
						"width": 425,
						"height": 500
					}
				}
			},
			"interop": {
				"intents": {
					"listensFor": {
						"TestNative": {
							"displayName": "Test Native",
							"contexts": ["fdc3.instrument"]
						}
					}
				}
			}
		}
	]
}
